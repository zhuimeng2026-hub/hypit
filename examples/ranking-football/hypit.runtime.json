{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "credentials": {
    "platform": {
      "use": "@hypit/credential-store-platform"
    }
  },
  "endpoints": {
    "media.local": {
      "use": "@hypit/provider-media-local",
      "config": {
        "defaultConcurrency": 2
      }
    },
    "hyperframes.local": {
      "use": "@hypit/provider-hyperframes-local",
      "config": {
        "workers": 2,
        "quality": "standard",
        "defaultConcurrency": 1,
        "browserGpu": "software",
        "initializationTimeoutMs": 180000,
        "frameTimeoutMs": 180000,
        "processTimeoutMs": 600000
      }
    },
    "whisperx.local": {
      "use": "@hypit/provider-whisperx-local",
      "config": {
        "baseUrl": "http://127.0.0.1:8765",
        "expectedModel": "small",
        "expectedDevice": "cpu",
        "expectedCompute": "int8",
        "expectedBatchSize": 8,
        "defaultConcurrency": 1
      }
    }
  }
}
