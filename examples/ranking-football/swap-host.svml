<?svml using="@hypit/markup@1"?>

<svml>
  <import from="@hypit/script@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="text" from="@hypit/text@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="narrative-caption" from="@hypit/narrative-caption@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio-track" from="@hypit/audio-track@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="ranking" from="@hypit/ranking@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="recipes" source="./tier-banana-recipes.svs"/>

  <!-- The Program projection owns the complete board lifetime. Each discussed
       footballer's complete Segment projects its disjoint reveal window, so
       TierBoard consumes windows without finding frames. Cue boundaries are author intent. -->
  <script id="story">
    <ronaldo>
      <HOST>Ronaldo is <D | Dee> tier. || Bro has @{hair-gel} more || hair gel than @{trophy} trophies || at this point.@{/trophy}@{/hair-gel} || Built like || @{greek-god} a Greek god, || plays like || @{greek-tragedy} a Greek tragedy.@{/greek-tragedy}@{/greek-god} || But hey, || at least @{penaldo-social} he's got || the most followers || on Instagram.@{/penaldo-social}
    </ronaldo>
    <messi>
      <HOST>Messi? Man won || a World Cup || @{tired-dad} looking like || somebody's tired dad.@{/tired-dad} || Walks around || @{walks-around} for 89 minutes, || touches the ball || three times, || and somehow || @{hat-trick} you just watched || a hat trick.@{/hat-trick}@{/walks-around} || Definitely <S | Ess> tier.
    </messi>
  </script>

  <asset:Image id="presenter" src="./assets/pregen/presenter-banana.png"/>
  <asset:Audio id="presenter-voice" src="./assets/cat.wav"/>
  <asset:Audio id="soundtrack" src="./assets/shared-soundtrack.m4a"/>
  <asset:Audio id="ranking-appear-sfx" src="./assets/ranking-appear.wav"/>
  <asset:Audio id="ranking-move-sfx" src="./assets/ranking-move.wav"/>
  <!-- Real supplied photographs identify the board entries. The swap-host
       SVML uses AI generation by default; we substitute real photos to avoid
       fabricating likenesses of real people. -->
  <asset:Image id="ronaldo-icon" src="./assets/ronaldo.jpeg"/>
  <asset:Image id="messi-icon" src="./assets/messi.jpeg"/>
  <asset:Image id="yamal-icon" src="./assets/yamal.jpg"/>
  <asset:Image id="haaland-icon" src="./assets/haaland.jpg"/>
  <asset:Image id="de-bruyne-icon" src="./assets/debrunye.jpg"/>
  <asset:Image id="bellingham-icon" src="./assets/bellingham-new.jpg"/>
  <asset:Image id="kane-icon" src="./assets/kane.jpg"/>
  <asset:Image id="modric-icon" src="./assets/modric.jpg"/>
  <asset:Image id="mbappe-icon" src="./assets/mbappe-new.jpg"/>
  <asset:Image id="neymar-icon" src="./assets/neymar.jpg"/>
  <asset:Image id="benzema-icon" src="./assets/benzema.jpg"/>

  <!-- The performed media supplies actual word timing. -->

  <text:Value id="ronaldo-action">
    Keep the handheld microphone in the same hand throughout, and use only the free hand for gestures. At the opening, widen his eyes and nod emphatically as he begins speaking. On "hair gel", deliberately run the free hand over his hair. On "Greek god", react with exaggerated surprise. On "Greek tragedy", shake his head with a mocking laugh. On "But hey", lean his body forward and raise the free index finger as if he has just thought of something. On the final sentence, give a sarcastic shrug.
  </text:Value>
  <text:Value id="messi-action">
    Keep the handheld microphone in the same hand throughout, and use only the free hand for gestures. Throughout the opening sentence, nod continuously in small rhythmic beats. On "tired dad", look both admiring and incredulous. On "Walks around", draw a small circle in the air with the free hand. On "touches the ball", point the free thumb toward the right side of frame. As he says the exact phrase "hat trick", look deeply impressed and lift and extend the free arm upward above shoulder level with the palm open toward the upper part of the frame. The prosody of "hat trick" is strict: put the primary lexical stress on HAT. Make HAT clearly higher, louder, longer, and more accented; make "trick" shorter, lighter, and lower. The pitch must fall sharply from HAT through "trick" and finish low and closed, as a confident statement. Do not stress TRICK, do not keep both words level, and absolutely do not use rising or question-like intonation. On the final sentence, give one firm affirmative nod.
  </text:Value>

  <!-- Comedy B-roll source images. Aspect ratio and resolution stay model
       parameters; semantic placement is authored separately in the Script. -->

  <asset:Image id="broll-hair-gel" src="./assets/pregen/broll-hair-gel.png"/>
  <asset:Image id="broll-trophy" src="./assets/pregen/broll-trophy.png"/>
  <asset:Image id="broll-greek-god" src="./assets/pregen/broll-greek-god.png"/>
  <asset:Image id="broll-greek-tragedy" src="./assets/pregen/broll-greek-tragedy.png"/>
  <asset:Image id="broll-penaldo-social" src="./assets/pregen/broll-penaldo-social.png"/>
  <asset:Image id="broll-tired-dad-trophy" src="./assets/pregen/broll-tired-dad-trophy.png"/>
  <asset:Image id="broll-walks-around" src="./assets/pregen/broll-walks-around.png"/>
  <asset:Image id="broll-hat-trick" src="./assets/pregen/broll-hat-trick.png"/>


  <!-- The only two A-roll Takes in the author programme. Reused public
       HypiHub performances so the build runs without Seedance access. -->
  <asset:Video id="ronaldo-take" src="./reused/ronaldo.mp4"/>
  <asset:Video id="messi-take" src="./reused/messi.mp4"/>

  <space:Canvas id="vertical" width="720" height="1280"/>
  <time:Clock id="clock" frame-rate="30"/>
  <mediaop:Normalize id="soundtrack-media" source={soundtrack}
    video="none" audio="default" span-authority="audio" clock={clock}/>
  <mediaop:Normalize id="ranking-appear-media" source={ranking-appear-sfx}
    video="none" audio="default" span-authority="audio" clock={clock}/>
  <mediaop:Normalize id="ranking-move-media" source={ranking-move-sfx}
    video="none" audio="default" span-authority="audio" clock={clock}/>
  <space:Frame id="speech-frame" within={vertical.bounds}
    left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="tier-frame" within={vertical.bounds}
    left="0%" top="55%" right="100%" bottom="100%"/>

  <!-- B-roll lives inside the lower board region. Deliberately varied card
       proportions and offsets keep the treatment playful without entering the
       caption band above it. Extents describe the generated image bytes. -->
  <space:Extent id="hair-gel-extent" width="2688" height="2016"/>
  <space:Extent id="trophy-extent" width="2048" height="2048"/>
  <space:Extent id="greek-god-extent" width="2016" height="2688"/>
  <space:Extent id="greek-tragedy-extent" width="2688" height="2016"/>
  <space:Extent id="penaldo-social-extent" width="2688" height="1152"/>
  <space:Extent id="tired-dad-extent" width="2336" height="1744"/>
  <space:Extent id="walks-around-extent" width="2688" height="2016"/>
  <space:Extent id="hat-trick-extent" width="2048" height="2048"/>

  <space:AspectFrame id="hair-gel-frame" within={vertical.bounds}
    x="34%" y="78%" width="58%" aspect={hair-gel-extent} anchor="center"/>
  <space:AspectFrame id="trophy-frame" within={vertical.bounds}
    x="73%" y="82%" width="42%" aspect={trophy-extent} anchor="center"/>
  <space:AspectFrame id="greek-god-frame" within={vertical.bounds}
    x="24%" y="78%" width="38%" aspect={greek-god-extent} anchor="center"/>
  <space:AspectFrame id="greek-tragedy-frame" within={vertical.bounds}
    x="63%" y="79%" width="66%" aspect={greek-tragedy-extent} anchor="center"/>
  <space:AspectFrame id="penaldo-social-frame" within={vertical.bounds}
    x="50%" y="78%" width="94%" aspect={penaldo-social-extent} anchor="center"/>
  <space:AspectFrame id="tired-dad-frame" within={vertical.bounds}
    x="58%" y="79%" width="62%" aspect={tired-dad-extent} anchor="center"/>
  <space:AspectFrame id="walks-around-frame" within={vertical.bounds}
    x="38%" y="79%" width="68%" aspect={walks-around-extent} anchor="center"/>
  <space:AspectFrame id="hat-trick-frame" within={vertical.bounds}
    x="72%" y="80%" width="46%" aspect={hat-trick-extent} anchor="center"/>

  <!-- Real Build path: generated video -> one shared normalization waist ->
       measured alignment. -->
  <mediaop:Normalize id="ronaldo-media" source={ronaldo-take}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <mediaop:Normalize id="messi-media" source={messi-take}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <whisperx:Alignment id="ronaldo-semantic" narrative={story}
    segment={story.segment.ronaldo} media={ronaldo-media.media} domain={ronaldo-media.domain} language="en"/>
  <whisperx:Alignment id="messi-semantic" narrative={story}
    segment={story.segment.messi} media={messi-media.media} domain={messi-media.domain} language="en"/>

  <time:Timeline id="speech" clock={clock} end="messi-semantic.end">
    <time:Window id="ronaldo-semantic" from="start" for={ronaldo-media.extent}/>
    <time:Window id="messi-semantic" from="ronaldo-semantic.end" for={messi-media.extent}/>
  </time:Timeline>


  <semantic:Projection id="story-time" narrative={story} timeline={speech.timeline}>
    <semantic:Map alignment={ronaldo-semantic.alignment} domain={ronaldo-media.domain} window={speech.ronaldo-semantic}/>
    <semantic:Map alignment={messi-semantic.alignment} domain={messi-media.domain} window={speech.messi-semantic}/>
  </semantic:Projection>
  <semantic:Window id="segment-ronaldo" projection={story-time} during={story.segment.ronaldo}/>
  <semantic:Window id="segment-messi" projection={story-time} during={story.segment.messi}/>
  <semantic:Window id="selection-hair-gel" projection={story-time} during={story.selection.hair-gel}/>
  <semantic:Window id="selection-trophy" projection={story-time} during={story.selection.trophy}/>
  <semantic:Window id="selection-greek-god" projection={story-time} during={story.selection.greek-god}/>
  <semantic:Window id="selection-greek-tragedy" projection={story-time} during={story.selection.greek-tragedy}/>
  <semantic:Window id="selection-penaldo-social" projection={story-time} during={story.selection.penaldo-social}/>
  <semantic:Window id="selection-tired-dad" projection={story-time} during={story.selection.tired-dad}/>
  <semantic:Window id="selection-walks-around" projection={story-time} during={story.selection.walks-around}/>
  <semantic:Window id="selection-hat-trick" projection={story-time} during={story.selection.hat-trick}/>
  <audio:Track id="speech-sound" timeline={speech.timeline}>
    <audio:Clip id="ronaldo-semantic-source" source={ronaldo-media.media} during={speech.ronaldo-semantic}/>
    <audio:Clip id="messi-semantic-source" source={messi-media.media} during={speech.messi-semantic}/>
  </audio:Track>
  <visual:Motion id="broll-left">
    <visual:Pose at="start" scale="0.7" opacity="0" easing="ease-out"/>
    <visual:Pose at="6f" scale="1" opacity="1"/>
    <visual:Pose at="end-4f" scale="1" opacity="1" easing="ease-in"/>
    <visual:Pose at="end" scale="1" opacity="0"/>
  </visual:Motion>
  <visual:Motion id="broll-right">
    <visual:Pose at="start" y="80" scale="0.92" opacity="0" easing="ease-out"/>
    <visual:Pose at="7f" y="0" scale="1" opacity="1"/>
    <visual:Pose at="end-4f" y="0" scale="1" opacity="1" easing="ease-in"/>
    <visual:Pose at="end" y="0" scale="0.94" opacity="1"/>
  </visual:Motion>
  <visual:Motion id="broll-wide">
    <visual:Pose at="start" scale="0.9" opacity="1" easing="ease-out"/>
    <visual:Pose at="6f" scale="1" opacity="1"/>
    <visual:Pose at="end-4f" scale="1" opacity="1" easing="ease-in"/>
    <visual:Pose at="end" scale="1" opacity="0"/>
  </visual:Motion>

  <visual:Track id="speech-picture" timeline={speech.timeline}>
    <visual:Clip id="ronaldo-semantic-source" media={ronaldo-media.media} during={speech.ronaldo-semantic} frame={speech-frame} z="0" fit="cover"/>
    <visual:Clip id="messi-semantic-source" media={messi-media.media} during={speech.messi-semantic} frame={speech-frame} z="0" fit="cover"/>
  </visual:Track>
  <audio-track:Track id="music-bed" timeline={speech.timeline}>
    <audio-track:Clip source={soundtrack-media.media} during={speech.window}
      gain="0.12" fade-in="300ms" fade-out="600ms"/>
  </audio-track:Track>

  <fonts:Face id="display-font" package="@fontsource-variable/montserrat" weight="900" style="normal"/>
  <fonts:Face id="tier-font" package="@fontsource-variable/inter" weight="400" style="normal"/>
  <ranking:TierBoardStyle id="tier-style" recipe={recipes.ranking.football}
    font={tier-font}/>
  <ranking:TierBoard id="football-tiers" timeline={speech.timeline}
    within={vertical.bounds} frame={tier-frame}
    during={speech.window} style={tier-style}
    appear-sound={ranking-appear-media.media}
    move-sound={ranking-move-media.media}>
    <ranking:TierItem id="yamal" tier="s" preset="true" icon={yamal-icon}/>
    <ranking:TierItem id="haaland" tier="a" preset="true" icon={haaland-icon}/>
    <ranking:TierItem id="de-bruyne" tier="b" preset="true" icon={de-bruyne-icon}/>
    <ranking:TierItem id="bellingham" tier="b" preset="true" icon={bellingham-icon}/>
    <ranking:TierItem id="kane" tier="c" preset="true" icon={kane-icon}/>
    <ranking:TierItem id="modric" tier="c" preset="true" icon={modric-icon}/>
    <ranking:TierItem id="mbappe" tier="d" preset="true" icon={mbappe-icon}/>
    <ranking:TierItem id="neymar" tier="d" preset="true" icon={neymar-icon}/>
    <ranking:TierItem id="benzema" tier="d" preset="true" icon={benzema-icon}/>
    <ranking:TierItem id="ronaldo" tier="d" entry="drop"
      icon={ronaldo-icon} during={segment-ronaldo}/>
    <ranking:TierItem id="messi" tier="s" entry="drop"
      icon={messi-icon} during={segment-messi}/>
  </ranking:TierBoard>

  <!-- Every Item consumes a projected Selection window. Later overlapping
       jokes use a higher explicit z on their own Clip occurrence. -->
  <visual:Track id="broll" timeline={speech.timeline}>
    <visual:Clip id="hair-gel" image={broll-hair-gel}
      extent={hair-gel-extent} during={selection-hair-gel}
      frame={hair-gel-frame} z="40" fit="cover" treatment={recipes.media.hair-gel}
      motion={broll-left}/>
    <visual:Clip id="trophy" image={broll-trophy}
      extent={trophy-extent} during={selection-trophy}
      frame={trophy-frame} z="41" fit="cover" treatment={recipes.media.trophy}
      motion={broll-right}/>
    <visual:Clip id="greek-god" image={broll-greek-god}
      extent={greek-god-extent} during={selection-greek-god}
      frame={greek-god-frame} z="42" fit="cover" treatment={recipes.media.greek-god}
      motion={broll-left}/>
    <visual:Clip id="greek-tragedy" image={broll-greek-tragedy}
      extent={greek-tragedy-extent} during={selection-greek-tragedy}
      frame={greek-tragedy-frame} z="43" fit="cover" treatment={recipes.media.greek-tragedy}
      motion={broll-right}/>
    <visual:Clip id="penaldo-social" image={broll-penaldo-social}
      extent={penaldo-social-extent} during={selection-penaldo-social}
      frame={penaldo-social-frame} z="44" fit="cover" treatment={recipes.media.penaldo-social}
      motion={broll-wide}/>
    <visual:Clip id="tired-dad" image={broll-tired-dad-trophy}
      extent={tired-dad-extent} during={selection-tired-dad}
      frame={tired-dad-frame} z="45" fit="cover" treatment={recipes.media.tired-dad}
      motion={broll-right}/>
    <visual:Clip id="walks-around" image={broll-walks-around}
      extent={walks-around-extent} during={selection-walks-around}
      frame={walks-around-frame} z="46" fit="cover" treatment={recipes.media.walks-around}
      motion={broll-left}/>
    <visual:Clip id="hat-trick" image={broll-hat-trick}
      extent={hat-trick-extent} during={selection-hat-trick}
      frame={hat-trick-frame} z="47" fit="cover" treatment={recipes.media.hat-trick}
      motion={broll-right}/>
  </visual:Track>

  <caption-fine:Style id="caption-style" recipe={recipes.caption.primary}
    font={display-font}/>

  <narrative-caption:Timing id="caption-timing" document={story.caption} binding={story.caption-binding} projection={story-time}/>
  <caption-fine:Caption id="captions" document={story.caption} timing={caption-timing}
    timeline={speech.timeline} within={vertical.bounds}>
    <caption-fine:Use style={caption-style}/>
  </caption-fine:Caption>

  <film:Film id="main" canvas={vertical.canvas} timeline={speech.timeline}
    appearance={recipes.film.vertical}>
    <film:Track source={speech-picture.visual}/>
    <film:Track source={speech-sound.audio}/>
    <film:Track source={football-tiers.visual}/>
    <film:Track source={football-tiers.audio}/>
    <film:Track source={broll.visual}/>
    <film:Track source={captions.visual}/>
    <film:Track source={music-bed.audio}/>
  </film:Film>
  <html:Video id="final" composition={main.composition}
    timeline={speech.timeline}/>
</svml>
