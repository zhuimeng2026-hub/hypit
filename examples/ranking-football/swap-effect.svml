<?svml using="@hypit/markup@1"?>

<svml>
  <import from="@hypit/script@1"/>
  <import as="audio" from="@hypit/audio-track@1"/>
  <import as="text" from="@hypit/text@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="mediaop" from="@hypit/media-operations@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="semantic" from="@hypit/narrative-temporal@1"/>
  <import as="narrative-caption" from="@hypit/narrative-caption@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="visual" from="@hypit/visual-track@1"/>
  <import as="audio-track" from="@hypit/audio-track@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="fonts" from="@hypit/fontsource@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="ranking" from="@hypit/ranking@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="recipes" source="./column-recipes.svs"/>

  <!-- Cue boundaries remain explicit author intent. The complete Messi and
       Ronaldo Segments are also the two disjoint Column reveal windows. -->
  <script id="story">
    <messi>
      <HOST>Messi is the bottom. || Five foot seven, || no muscles, || no speed, || just vibes. || @{pitch-pov} Man walks around || the pitch like || @{ikea-sign} he's lost in <IKEA | eye KEE uh>.@{/ikea-sign}@{/pitch-pov} || @{retirement-room} Went to Miami || and turned the league || into a retirement home.@{/retirement-room}
    </messi>
    <ronaldo>
      <HOST>Ronaldo? Bro is || 39 years old || @{rent-jump} and still jumps || higher than your rent.@{/rent-jump} || @{nine-hundred-goals} Nine hundred goals, || @{laboratory-body} a body built || in a laboratory, || @{museum-jawline} and a jawline || that belongs || in a museum.@{/museum-jawline}@{/laboratory-body}@{/nine-hundred-goals} || Absolutely the top one.
    </ronaldo>
  </script>

  <!-- The only two A-roll Takes in the author programme. Reused public
       HypiHub performances so the build runs without Seedance access. -->
  <asset:Image id="presenter" src="./assets/pregen/presenter-banana.png"/>
  <asset:Audio id="presenter-voice" src="./assets/goth.wav"/>
  <asset:Audio id="soundtrack" src="./assets/shared-soundtrack.m4a"/>
  <asset:Audio id="ranking-appear-sfx" src="./assets/ranking-appear.wav"/>
  <asset:Audio id="ranking-move-sfx" src="./assets/ranking-move.wav"/>
  <asset:Image id="ronaldo-icon" src="./assets/ronaldo.jpeg"/>
  <asset:Image id="messi-icon" src="./assets/messi.jpeg"/>
  <asset:Image id="mbappe-icon" src="./assets/mbappe-new.jpg"/>
  <asset:Image id="haaland-icon" src="./assets/haaland.jpg"/>
  <asset:Image id="bellingham-icon" src="./assets/bellingham-new.jpg"/>
  <asset:Image id="de-bruyne-icon" src="./assets/debrunye.jpg"/>
  <asset:Image id="yamal-icon" src="./assets/yamal.jpg"/>
  <asset:Image id="kane-icon" src="./assets/kane.jpg"/>
  <asset:Image id="modric-icon" src="./assets/modric.jpg"/>
  <asset:Image id="neymar-icon" src="./assets/neymar.jpg"/>

  <text:Value id="messi-action">
    Keep the handheld microphone in the same hand throughout and use only the free hand for gestures. On "Messi is the bottom", lower the free palm toward the floor and give one deadpan downward nod. On "Five foot seven", hold the free hand low as if marking a short height. Give three small counting beats through "no muscles, no speed, just vibes", ending with a loose shoulder shrug and an amused half-smile on "just vibes". On "Man walks around", slowly draw a lazy circle in the air. On "lost in IKEA", glance left and right with a puzzled squint, then point uncertainly off frame. On "retirement home", briefly hunch the shoulders and mime one slow old-man step with the free hand before finishing with a knowing smirk.
  </text:Value>
  <text:Value id="ronaldo-action">
    Keep the handheld microphone in the same hand throughout and use only the free hand for gestures. Keep the presenter's face, skin, hair, clothing, body, microphone, room, lighting, and natural human appearance continuous and unchanged from the first frame to the last. Open with a skeptical raised eyebrow on "Ronaldo?" and one emphatic nod on "39 years old". On "still jumps higher than your rent", drive the free hand sharply upward above shoulder level and follow it with the eyes, then land the punchline with a sarcastic grin. Present "Nine hundred goals" with one broad, confident sweep of the free hand. On "a body built in a laboratory", briefly flex the free arm, tap the bicep once, and immediately return to a relaxed natural speaking posture while keeping the face animated. On "jawline", trace the edge of the jaw once with the free index finger. On "museum", turn the free palm outward as if presenting an expensive exhibit offscreen, raise one eyebrow, and keep talking naturally. On "Absolutely the top one", raise one index finger decisively and finish with a firm nod.
  </text:Value>

  <!-- Aspect ratio is model configuration, never prose hidden in the prompt. -->

  <asset:Image id="broll-pitch-pov" src="./assets/pregen/broll-pitch-pov.png"/>
  <asset:Image id="broll-ikea-sign" src="./assets/pregen/broll-ikea-sign.png"/>
  <asset:Image id="broll-retirement-room" src="./assets/pregen/broll-retirement-room.png"/>
  <asset:Image id="broll-rent-jump" src="./assets/pregen/broll-rent-jump.png"/>
  <asset:Image id="broll-nine-hundred" src="./assets/pregen/broll-nine-hundred.png"/>
  <asset:Image id="broll-laboratory-body" src="./assets/pregen/broll-laboratory-body.png"/>
  <asset:Image id="broll-museum-jawline" src="./assets/pregen/broll-museum-jawline.png"/>


  <asset:Video id="messi-take" src="./reused/messi.mp4"/>
  <asset:Video id="ronaldo-take" src="./reused/ronaldo.mp4"/>

  <space:Canvas id="vertical" width="720" height="1280"/>
  <time:Clock id="clock" frame-rate="30"/>
  <mediaop:Normalize id="soundtrack-media" source={soundtrack}
    video="none" audio="default" span-authority="audio" clock={clock}/>
  <mediaop:Normalize id="ranking-appear-media" source={ranking-appear-sfx}
    video="none" audio="default" span-authority="audio" clock={clock}/>
  <mediaop:Normalize id="ranking-move-media" source={ranking-move-sfx}
    video="none" audio="default" span-authority="audio" clock={clock}/>
  <space:Frame id="speech-frame" within={vertical.bounds}
    left="0%" top="0%" right="100%" bottom="100%"/>
  <space:Frame id="column-frame" within={vertical.bounds}
    left="0%" top="10%" right="26%" bottom="67.5%"/>

  <space:Extent id="pitch-pov-extent" width="2688" height="2016"/>
  <space:Extent id="ikea-sign-extent" width="2048" height="2048"/>
  <space:Extent id="retirement-room-extent" width="2688" height="2016"/>
  <space:Extent id="rent-jump-extent" width="2688" height="2016"/>
  <space:Extent id="nine-hundred-extent" width="2048" height="2048"/>
  <space:Extent id="laboratory-body-extent" width="2016" height="2688"/>
  <space:Extent id="museum-jawline-extent" width="2048" height="2048"/>

  <!-- These straight-edged cards occupy the same right-side stage as the
       active Column item. They have no border, rounded mask or sustain motion. -->
  <space:AspectFrame id="pitch-pov-frame" within={vertical.bounds}
    x="50%" y="72%" width="74%" aspect={pitch-pov-extent} anchor="center"/>
  <space:AspectFrame id="ikea-sign-frame" within={vertical.bounds}
    x="75%" y="79%" width="50%" aspect={ikea-sign-extent} anchor="center"/>
  <space:AspectFrame id="retirement-room-frame" within={vertical.bounds}
    x="52%" y="75%" width="88%" aspect={retirement-room-extent} anchor="center"/>
  <space:AspectFrame id="rent-jump-frame" within={vertical.bounds}
    x="52%" y="75%" width="78%" aspect={rent-jump-extent} anchor="center"/>
  <space:AspectFrame id="nine-hundred-frame" within={vertical.bounds}
    x="25%" y="72%" width="50%" aspect={nine-hundred-extent} anchor="center"/>
  <space:AspectFrame id="laboratory-body-frame" within={vertical.bounds}
    x="50%" y="68%" width="46%" aspect={laboratory-body-extent} anchor="center"/>
  <space:AspectFrame id="museum-jawline-frame" within={vertical.bounds}
    x="75%" y="78%" width="50%" aspect={museum-jawline-extent} anchor="center"/>

  <mediaop:Normalize id="messi-media" source={messi-take}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <mediaop:Normalize id="ronaldo-media" source={ronaldo-take}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>
  <whisperx:Alignment id="messi-semantic" narrative={story}
    segment={story.segment.messi} media={messi-media.media} domain={messi-media.domain} language="en"/>
  <whisperx:Alignment id="ronaldo-semantic" narrative={story}
    segment={story.segment.ronaldo} media={ronaldo-media.media} domain={ronaldo-media.domain} language="en"/>

  <time:Timeline id="speech" clock={clock} end="ronaldo-semantic.end">
    <time:Window id="messi-semantic" from="start" for={messi-media.extent}/>
    <time:Window id="ronaldo-semantic" from="messi-semantic.end" for={ronaldo-media.extent}/>
  </time:Timeline>


  <semantic:Projection id="story-time" narrative={story} timeline={speech.timeline}>
    <semantic:Map alignment={messi-semantic.alignment} domain={messi-media.domain} window={speech.messi-semantic}/>
    <semantic:Map alignment={ronaldo-semantic.alignment} domain={ronaldo-media.domain} window={speech.ronaldo-semantic}/>
  </semantic:Projection>
  <semantic:Window id="segment-ronaldo" projection={story-time} during={story.segment.ronaldo}/>
  <semantic:Window id="segment-messi" projection={story-time} during={story.segment.messi}/>
  <semantic:Window id="selection-pitch-pov" projection={story-time} during={story.selection.pitch-pov}/>
  <semantic:Window id="selection-ikea-sign" projection={story-time} during={story.selection.ikea-sign}/>
  <semantic:Window id="selection-retirement-room" projection={story-time} during={story.selection.retirement-room}/>
  <semantic:Window id="selection-rent-jump" projection={story-time} during={story.selection.rent-jump}/>
  <semantic:Window id="selection-nine-hundred-goals" projection={story-time} during={story.selection.nine-hundred-goals}/>
  <semantic:Window id="selection-laboratory-body" projection={story-time} during={story.selection.laboratory-body}/>
  <semantic:Window id="selection-museum-jawline" projection={story-time} during={story.selection.museum-jawline}/>
  <audio:Track id="speech-sound" timeline={speech.timeline}>
    <audio:Clip id="messi-semantic-source" source={messi-media.media} during={speech.messi-semantic}/>
    <audio:Clip id="ronaldo-semantic-source" source={ronaldo-media.media} during={speech.ronaldo-semantic}/>
  </audio:Track>
  <visual:Motion id="broll-motion">
    <visual:Pose at="start" scale="0.7" opacity="0" easing="ease-out"/>
    <visual:Pose at="6f" scale="1" opacity="1"/>
    <visual:Pose at="end-4f" scale="1" opacity="1" easing="ease-in"/>
    <visual:Pose at="end" scale="1" opacity="0"/>
  </visual:Motion>

  <visual:Track id="speech-picture" timeline={speech.timeline}>
    <visual:Clip id="messi-semantic-source" media={messi-media.media} during={speech.messi-semantic} frame={speech-frame} z="0" fit="cover"/>
    <visual:Clip id="ronaldo-semantic-source" media={ronaldo-media.media} during={speech.ronaldo-semantic} frame={speech-frame} z="0" fit="cover"/>
  </visual:Track>
  <audio-track:Track id="music-bed" timeline={speech.timeline}>
    <audio-track:Clip source={soundtrack-media.media} during={speech.window}
      gain="0.12" fade-in="300ms" fade-out="600ms"/>
  </audio-track:Track>

  <fonts:Face id="display-font" package="@fontsource-variable/montserrat" weight="900" style="normal"/>
  <fonts:Face id="column-font" package="@fontsource-variable/inter" weight="700" style="normal"/>
  <ranking:ColumnStyle id="column-style" recipe={recipes.ranking.football-column}
    font={column-font}/>
  <ranking:Column id="football-column" timeline={speech.timeline}
    within={vertical.bounds} frame={column-frame} during={speech.window} style={column-style}
    appear-sound={ranking-appear-media.media}
    move-sound={ranking-move-media.media}>
    <ranking:ColumnItem id="ronaldo" rank="1" label="Ronaldo"
      icon={ronaldo-icon} during={segment-ronaldo}/>
    <ranking:ColumnItem id="mbappe" rank="2" label="Mbappe"
      preset="true" icon={mbappe-icon}/>
    <ranking:ColumnItem id="haaland" rank="3" label="Haaland"
      preset="true" icon={haaland-icon}/>
    <ranking:ColumnItem id="bellingham" rank="4" label="Bellingham"
      preset="true" icon={bellingham-icon}/>
    <ranking:ColumnItem id="de-bruyne" rank="5" label="De Bruyne"
      preset="true" icon={de-bruyne-icon}/>
    <ranking:ColumnItem id="yamal" rank="6" label="Yamal"
      preset="true" icon={yamal-icon}/>
    <ranking:ColumnItem id="kane" rank="7" label="Kane"
      preset="true" icon={kane-icon}/>
    <ranking:ColumnItem id="modric" rank="8" label="Modric"
      preset="true" icon={modric-icon}/>
    <ranking:ColumnItem id="neymar" rank="9" label="Neymar"
      preset="true" icon={neymar-icon}/>
    <ranking:ColumnItem id="messi" rank="10" label="Messi"
      icon={messi-icon} during={segment-messi}/>
  </ranking:Column>

  <visual:Track id="broll" timeline={speech.timeline}>
    <visual:Clip id="pitch-pov" image={broll-pitch-pov}
      extent={pitch-pov-extent} during={selection-pitch-pov}
      frame={pitch-pov-frame} z="40" fit="cover" treatment={recipes.media.pitch-pov}
      motion={broll-motion}/>
    <visual:Clip id="ikea-sign" image={broll-ikea-sign}
      extent={ikea-sign-extent} during={selection-ikea-sign}
      frame={ikea-sign-frame} z="41" fit="cover" treatment={recipes.media.ikea-sign}
      motion={broll-motion}/>
    <visual:Clip id="retirement-room" image={broll-retirement-room}
      extent={retirement-room-extent} during={selection-retirement-room}
      frame={retirement-room-frame} z="42" fit="cover" treatment={recipes.media.retirement-room}
      motion={broll-motion}/>
    <visual:Clip id="rent-jump" image={broll-rent-jump}
      extent={rent-jump-extent} during={selection-rent-jump}
      frame={rent-jump-frame} z="43" fit="cover" treatment={recipes.media.rent-jump}
      motion={broll-motion}/>
    <visual:Clip id="nine-hundred-goals" image={broll-nine-hundred}
      extent={nine-hundred-extent} during={selection-nine-hundred-goals}
      frame={nine-hundred-frame} z="44" fit="cover" treatment={recipes.media.nine-hundred}
      motion={broll-motion}/>
    <visual:Clip id="laboratory-body" image={broll-laboratory-body}
      extent={laboratory-body-extent} during={selection-laboratory-body}
      frame={laboratory-body-frame} z="45" fit="cover" treatment={recipes.media.laboratory-body}
      motion={broll-motion}/>
    <visual:Clip id="museum-jawline" image={broll-museum-jawline}
      extent={museum-jawline-extent} during={selection-museum-jawline}
      frame={museum-jawline-frame} z="46" fit="cover" treatment={recipes.media.museum-jawline}
      motion={broll-motion}/>
  </visual:Track>

  <caption-fine:Style id="caption-style" recipe={recipes.caption.primary}
    font={display-font}/>

  <narrative-caption:Timing id="caption-timing" document={story.caption} binding={story.caption-binding} projection={story-time}/>
  <caption-fine:Caption id="captions" document={story.caption} timing={caption-timing}
    timeline={speech.timeline} within={vertical.bounds}>
    <caption-fine:Use style={caption-style}/>
  </caption-fine:Caption>

  <film:Film id="main" canvas={vertical.canvas} timeline={speech.timeline}
    appearance={recipes.film.vertical}>
    <film:Track source={speech-picture.visual}/>
    <film:Track source={speech-sound.audio}/>
    <film:Track source={football-column.visual}/>
    <film:Track source={football-column.audio}/>
    <film:Track source={broll.visual}/>
    <film:Track source={captions.visual}/>
    <film:Track source={music-bed.audio}/>
  </film:Film>
  <html:Video id="final" composition={main.composition}
    timeline={speech.timeline}/>
</svml>
