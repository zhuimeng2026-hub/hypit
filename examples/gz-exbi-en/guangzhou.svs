<?svml using="@hypit/recipe@1"?>

<sheet version="1">
  /* 迁移说明：原 media.cover 及仅靠 stack-order 区分的 cover-2 … cover-8
     （全部从未被 guangzhou.svml 引用）把 stack-order 与 fit 都已迁到
     visual-track 的 Clip 属性 z= / fit=；treatment recipe 在新词汇下
     只接受视觉效果（opacity/blur/clip/frame…），故整组删除。 */
  film.vertical {
    background: #000000;
  }
</sheet>
