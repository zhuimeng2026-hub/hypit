<?svml using="@hypit/recipe@1"?>

<sheet version="1">
  /* 迁移说明：原 media.cover（及仅靠 stack-order 区分、从未被引用的
     cover-2 … cover-11）的 stack-order 与 fit 都已迁到 visual-track 的
     Clip 属性 z= / fit=；treatment recipe 在新词汇下只接受视觉效果
     （opacity/blur/clip/frame…），故整条删除。 */
  film.vertical {
    background: #000000;
  }
</sheet>
