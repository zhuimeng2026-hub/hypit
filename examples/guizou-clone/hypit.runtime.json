{
  "format": "hypit.runtime-local@1",
  "dataRoot": ".hypit/runtimes/local",
  "credentials": {
    "env": {
      "use": "@hypit/credential-store-env"
    }
  },
  "endpoints": {
    "media.local": {
      "use": "@hypit/media-local",
      "config": {
        "defaultConcurrency": 2
      }
    },
    "html.local": {
      "use": "@hypit/provider-html-local",
      "config": {
        "workers": 2,
        "quality": "draft",
        "defaultConcurrency": 1,
        "browserGpu": "software",
        "initializationTimeoutMs": 180000,
        "frameTimeoutMs": 1800000,
        "processTimeoutMs": 3600000,
        "protocolTimeoutMs": 1800000,
        "chromePath": "/root/.cache/hypit/html-rasterizer/chrome/chrome-headless-shell/linux-152.0.7928.2/chrome-headless-shell-linux64/chrome-headless-shell"
      }
    },
    "whisperx.local": {
      "use": "@hypit/provider-whisperx-local",
      "config": {
        "baseUrl": "http://127.0.0.1:8765",
        "expectedModel": "small",
        "expectedDevice": "cpu",
        "expectedCompute": "int8",
        "expectedBatchSize": 8,
        "defaultConcurrency": 1
      }
    }
  },
  "bindings": {
    "@hypit/whisperx@1#whisperx-alignment": "whisperx.local"
  }
}