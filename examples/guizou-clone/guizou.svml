<?svml using="@hypit/markup@1"?>

<svml>
  <import as="text" from="@hypit/text@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="pipeline" from="@hypit/media-operations@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="media-track" from="@hypit/visual-track@1"/>
  <import as="audio-track" from="@hypit/audio-track@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="recipes" source="./guizou.svs"/>

  <!-- ============================================================
       10 Hidden Gems in Guizhou — English-language clone.

       The reference is a 7-minute portrait Chinese travel listicle.
       This project keeps the same template (location pin header +
       bottom subtitle + B-roll per spot + ambient narration) but
       replaces the content with English narration by Microsoft
       Guy Neural (edge-tts) and a generated presenter.

       Each spot used to be an empty <script> Segment with a
       whisperx:SemanticTake; 205bfeb9 removed both, so the timeline is
       now an explicit <time:Window> chain below (same durations — the old
       empty-segment path took each window's length from its own media). No spoken
       alignment is required.
       ============================================================ -->

  <time:Clock id="clock" frame-rate="10"/>

  <!-- ----- Voiceover: one continuous mp3, 138s, edge-tts Guy. -->
  <asset:Audio id="narration" src="./assets/narration.mp3"/>
  <pipeline:Normalize id="narration-media" source={narration}
    video="none" audio="default" span-authority="audio" clock={clock}/>

  <!-- ----- B-roll: 10 spot clips + outro, ~35s each, sliced from
       the reference mp4. Each B-roll becomes one <time:Window>. -->
  <asset:Video id="broll-01-zhenshan" src="./assets/broll/spot-01-zhenshan.mp4"/>
  <pipeline:Normalize id="broll-01-media" source={broll-01-zhenshan}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>

  <asset:Video id="broll-02-longli" src="./assets/broll/spot-02-longli.mp4"/>
  <pipeline:Normalize id="broll-02-media" source={broll-02-longli}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>

  <asset:Video id="broll-03-guilan" src="./assets/broll/spot-03-guilan.mp4"/>
  <pipeline:Normalize id="broll-03-media" source={broll-03-guilan}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>

  <asset:Video id="broll-04-zengchong" src="./assets/broll/spot-04-zengchong.mp4"/>
  <pipeline:Normalize id="broll-04-media" source={broll-04-zengchong}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>

  <asset:Video id="broll-05-suoga-miao" src="./assets/broll/spot-05-suoga-miao.mp4"/>
  <pipeline:Normalize id="broll-05-media" source={broll-05-suoga-miao}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>

  <asset:Video id="broll-06-shitouzhai" src="./assets/broll/spot-06-shitouzhai.mp4"/>
  <pipeline:Normalize id="broll-06-media" source={broll-06-shitouzhai}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>

  <asset:Video id="broll-07-gaodang" src="./assets/broll/spot-07-gaodang.mp4"/>
  <pipeline:Normalize id="broll-07-media" source={broll-07-gaodang}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>

  <asset:Video id="broll-08-jiacha" src="./assets/broll/spot-08-jiacha.mp4"/>
  <pipeline:Normalize id="broll-08-media" source={broll-08-jiacha}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>

  <asset:Video id="broll-09-aile" src="./assets/broll/spot-09-aile.mp4"/>
  <pipeline:Normalize id="broll-09-media" source={broll-09-aile}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>

  <asset:Video id="broll-10-shimenkan" src="./assets/broll/spot-10-shimenkan.mp4"/>
  <pipeline:Normalize id="broll-10-media" source={broll-10-shimenkan}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>

  <asset:Video id="broll-outro" src="./assets/broll/outro-city.mp4"/>
  <pipeline:Normalize id="broll-outro-media" source={broll-outro}
    video="primary-moving" audio="default" span-authority="video" clock={clock}/>

  <!-- ----- Script: 11 empty segments — one per B-roll slot. The
       empty-segment path needs no WhisperX alignment; the
       prepared-media boundaries become the segment boundaries. -->

  <!-- (迁移后此处原有的 SemanticTake 块已删除，改由上方 Window 链承担)
       whose duration equals the prepared media's own duration. -->

  <!-- ----- Timeline: 11 Takes in performance order, end defaults to
       the last Take's end, no extra offset. -->
  <time:Timeline id="speech" clock={clock} end="broll-outro.end">
    <time:Window id="broll-01" from="start" for={broll-01-media.extent}/>
    <time:Window id="broll-02" from="broll-01.end" for={broll-02-media.extent}/>
    <time:Window id="broll-03" from="broll-02.end" for={broll-03-media.extent}/>
    <time:Window id="broll-04" from="broll-03.end" for={broll-04-media.extent}/>
    <time:Window id="broll-05" from="broll-04.end" for={broll-05-media.extent}/>
    <time:Window id="broll-06" from="broll-05.end" for={broll-06-media.extent}/>
    <time:Window id="broll-07" from="broll-06.end" for={broll-07-media.extent}/>
    <time:Window id="broll-08" from="broll-07.end" for={broll-08-media.extent}/>
    <time:Window id="broll-09" from="broll-08.end" for={broll-09-media.extent}/>
    <time:Window id="broll-10" from="broll-09.end" for={broll-10-media.extent}/>
    <time:Window id="broll-outro" from="broll-10.end" for={broll-outro-media.extent}/>
  </time:Timeline>

  <!-- ----- Canvas: 720x1280 portrait. -->
  <space:Canvas id="vertical" width="360" height="640"/>

  <!-- ----- Full-bleed frame: cover the whole 720x1280 canvas. -->
  <space:Frame id="full-frame" within={vertical.bounds} left="0px" top="0px" right="360px" bottom="640px"/>

  <!-- ----- B-roll track: each clip placed full-bleed across its
       Take's window — since each Take is consecutive, the picture
       switches at the Take boundaries. -->
  <media-track:Track id="broll" timeline={speech.timeline}>
    <media-track:Clip id="broll-01-item" media={broll-01-media.media}
      during={speech.broll-01} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-02-item" media={broll-02-media.media}
      during={speech.broll-02} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-03-item" media={broll-03-media.media}
      during={speech.broll-03} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-04-item" media={broll-04-media.media}
      during={speech.broll-04} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-05-item" media={broll-05-media.media}
      during={speech.broll-05} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-06-item" media={broll-06-media.media}
      during={speech.broll-06} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-07-item" media={broll-07-media.media}
      during={speech.broll-07} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-08-item" media={broll-08-media.media}
      during={speech.broll-08} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-09-item" media={broll-09-media.media}
      during={speech.broll-09} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-10-item" media={broll-10-media.media}
      during={speech.broll-10} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="outro-item" media={broll-outro-media.media}
      during={speech.broll-outro} frame={full-frame}
      z="10" fit="cover"/>
  </media-track:Track>

  <!-- ----- Audio track: continuous narration, once-start, plays
       across the whole timeline (it is shorter than the video). -->
  <audio-track:Track id="voice" timeline={speech.timeline}>
    <audio-track:Clip id="voice-item" source={narration-media.media}
      during={speech.window} gain="1" fade-in="200ms" fade-out="500ms"/>
  </audio-track:Track>

  <!-- ----- Final film composition. -->
  <film:Film id="main" appearance={recipes.film.vertical} canvas={vertical.canvas} timeline={speech.timeline}>
    <film:Track source={broll.visual}/>
    <film:Track source={voice.audio}/>
  </film:Film>

  <html:Video id="final" composition={main.composition}
    timeline={speech.timeline}/>
</svml>