<?svml using="@hypit/markup@1"?>

<svml>
  <import as="text" from="@hypit/text@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="pipeline" from="@hypit/media-operations@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="media-track" from="@hypit/visual-track@1"/>
  <import as="audio-track" from="@hypit/audio-track@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="mi" from="@hypit/minimax-image@1"/>
  <import as="recipes" source="./text-to-image.svs"/>

  <!-- ============================================================
       Text-to-image inside the Build graph, with no video-generation
       model anywhere in the Profile.

       This is the seam that neither kind of existing example covers:

         gz-exbi-en / guangzhou-clone  render only stills, but the stills
           are generated OUT-OF-BAND (gen-images.sh curls MiniMax, drops a
           jpg in assets/, `asset:Image` reads it). The Build itself
           spends zero image-API money and is idempotent.
         ranking-football / podcast / interview  generate IN-GRAPH with
           <gpt:Image>, but every one of them also mounts seedance video
           nodes, so they never render from stills alone.

       Spot 1 below is generated by <mi:TextImage> during the Build and
       feeds <pipeline:Still> directly; spots 2–8 stay as checked-in
       <asset:Image> files. Both idioms sit side by side on purpose —
       swap any one of them independently.

       8 StillVideos, 7s each = 56s on a 30fps clock. Narration is one
       continuous edge-tts mp3 laid across the whole timeline.
       ============================================================ -->

  <time:Clock id="clock" frame-rate="30"/>

  <!-- ----- Voiceover: one continuous mp3 generated by edge-tts. -->
  <asset:Audio id="narration" src="./assets/narration.mp3"/>
  <pipeline:Normalize id="narration-media" source={narration}
    video="none" audio="default" span-authority="audio" clock={clock}/>

  <!-- ----- B-roll: 7 exhibition spots + outro, all 7s stills on
       the 30fps clock via <pipeline:StillVideo>. Each image becomes a
       210-frame MP4 with no audio. -->

  <!-- Spot 1 — generated DURING the Build by MiniMax image-01. The element
       publishes `<id>.image` as an ordinary Blob, so <pipeline:Still>
       consumes it exactly like an <asset:Image>; no temp file, no
       pre-generation step. `aspect-ratio` must match the canvas, not the
       final crop — 9:16 for the 720x1280 frame below. -->
  <text:Value id="shot-01-prompt">Vertical cinematic travel photograph of the Taikoo Fanjing sculpture plaza in Guangzhou, warm late-afternoon light, weathered bronze figurative sculptures on a granite plaza, modern city towers behind, realistic textures, no text, no watermark</text:Value>
  <mi:TextImage id="shot-01" prompt={shot-01-prompt}
    aspect-ratio="9:16" n="1" response-format="url" prompt-optimizer="true"/>
  <pipeline:StillVideo id="broll-01-video" duration="210f" clock={clock}>
    <pipeline:Still source={shot-01.image}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-01-media" source={broll-01-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <!-- Spots 2–8 — the checked-in alternative. Swap any of these to the
       <mi:TextImage> shape above to move it in-graph. -->

  <asset:Image id="broll-02-rollin" src="./assets/broll/spot-02-k11-rollinwild.jpg"/>
  <pipeline:StillVideo id="broll-02-video" duration="210f" clock={clock}>
    <pipeline:Still source={broll-02-rollin}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-02-media" source={broll-02-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-03-prince" src="./assets/broll/spot-03-k11-littleprince.jpg"/>
  <pipeline:StillVideo id="broll-03-video" duration="210f" clock={clock}>
    <pipeline:Still source={broll-03-prince}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-03-media" source={broll-03-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-04-opera" src="./assets/broll/spot-04-opera-picasso.jpg"/>
  <pipeline:StillVideo id="broll-04-video" duration="210f" clock={clock}>
    <pipeline:Still source={broll-04-opera}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-04-media" source={broll-04-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-05-nanyue" src="./assets/broll/spot-05-nanyue-giftofnile.jpg"/>
  <pipeline:StillVideo id="broll-05-video" duration="210f" clock={clock}>
    <pipeline:Still source={broll-05-nanyue}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-05-media" source={broll-05-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-06-sihai" src="./assets/broll/spot-06-sihai-city.jpg"/>
  <pipeline:StillVideo id="broll-06-video" duration="210f" clock={clock}>
    <pipeline:Still source={broll-06-sihai}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-06-media" source={broll-06-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-07-lingnan" src="./assets/broll/spot-07-lingnan-local.jpg"/>
  <pipeline:StillVideo id="broll-07-video" duration="210f" clock={clock}>
    <pipeline:Still source={broll-07-lingnan}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-07-media" source={broll-07-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-outro" src="./assets/broll/spot-outro-city.jpg"/>
  <pipeline:StillVideo id="broll-outro-video" duration="210f" clock={clock}>
    <pipeline:Still source={broll-outro}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-outro-media" source={broll-outro-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <!-- ----- Script: 8 truly empty Segments. Boundary fragment maps
       each Segment to its StillVideo's own boundaries. -->


  <!-- ----- Timeline: 8 Takes in performance order. -->
  <time:Timeline id="speech" clock={clock} end="broll-outro.end">
    <time:Window id="broll-01" from="start" for={broll-01-media.extent}/>
    <time:Window id="broll-02" from="broll-01.end" for={broll-02-media.extent}/>
    <time:Window id="broll-03" from="broll-02.end" for={broll-03-media.extent}/>
    <time:Window id="broll-04" from="broll-03.end" for={broll-04-media.extent}/>
    <time:Window id="broll-05" from="broll-04.end" for={broll-05-media.extent}/>
    <time:Window id="broll-06" from="broll-05.end" for={broll-06-media.extent}/>
    <time:Window id="broll-07" from="broll-06.end" for={broll-07-media.extent}/>
    <time:Window id="broll-outro" from="broll-07.end" for={broll-outro-media.extent}/>
  </time:Timeline>

  <!-- ----- Canvas: 720x1280 portrait. -->
  <space:Canvas id="vertical" width="720" height="1280"/>
  <space:Frame id="full-frame" within={vertical.bounds} left="0px" top="0px" right="720px" bottom="1280px"/>

  <!-- ----- Image track: each still placed full-bleed across its
       Segment's window. Picture switches at Take boundaries. -->
  <media-track:Track id="broll" timeline={speech.timeline}>
    <media-track:Clip id="broll-01-item" media={broll-01-media.media}
      during={speech.broll-01} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-02-item" media={broll-02-media.media}
      during={speech.broll-02} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-03-item" media={broll-03-media.media}
      during={speech.broll-03} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-04-item" media={broll-04-media.media}
      during={speech.broll-04} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-05-item" media={broll-05-media.media}
      during={speech.broll-05} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-06-item" media={broll-06-media.media}
      during={speech.broll-06} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="broll-07-item" media={broll-07-media.media}
      during={speech.broll-07} frame={full-frame}
      z="10" fit="cover"/>
    <media-track:Clip id="outro-item" media={broll-outro-media.media}
      during={speech.broll-outro} frame={full-frame}
      z="10" fit="cover"/>
  </media-track:Track>

  <!-- ----- Audio track: continuous narration, plays across the
       whole timeline (it is slightly longer than the video). -->
  <audio-track:Track id="voice" timeline={speech.timeline}>
    <audio-track:Clip id="voice-item" source={narration-media.media}
      during={speech.window} gain="1" fade-in="200ms" fade-out="500ms"/>
  </audio-track:Track>

  <!-- ----- Final film composition. -->
  <film:Film id="main" appearance={recipes.film.vertical} canvas={vertical.canvas} timeline={speech.timeline}>
    <film:Track source={broll.visual}/>
    <film:Track source={voice.audio}/>
  </film:Film>

  <html:Video id="text-to-image-final" composition={main.composition}
    timeline={speech.timeline}/>
</svml>