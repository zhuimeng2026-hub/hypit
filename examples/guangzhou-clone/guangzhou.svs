<?svml using="@hypit/recipe@1"?>

<sheet version="1">
  /* 迁移说明：本片不需要任何视觉 treatment。
     旧 media.cover 的 stack-order 与 fit 都已迁到 visual-track 的 Clip
     属性（z= / fit=），而 treatment recipe 在新词汇下只接受视觉效果
     （opacity/blur/clip/frame…），故原 media.cover 整条删除。 */
  film.vertical {
    background: #000000;
  }
</sheet>
