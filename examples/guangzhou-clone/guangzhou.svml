<?svml using="@hypit/markup@1"?>

<svml>
  <import as="text" from="@hypit/text@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="pipeline" from="@hypit/media-operations@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="media-track" from="@hypit/visual-track@1"/>
  <import as="audio-track" from="@hypit/audio-track@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="html" from="@hypit/html-video@1"/>
  <import as="recipes" source="./guangzhou.svs"/>

  <!-- ============================================================
       10 Hidden Gems in Guangzhou — English-language portrait clone.

       Reuses the Guizhou-clone structure (location header + bottom
       subtitle + B-roll per spot + ambient narration) but replaces
       the source content: B-roll is generated by MiniMax text-to-image
       (no .mp4 in repo), and the narration mp3 is generated by
       edge-tts. Each spot is a truly empty <script> Segment — the
       empty-segment boundary path maps the StillVideo duration to
       the Segment, so no speech evidence audio is required.
       ============================================================ -->

  <time:Clock id="clock" frame-rate="30"/>

  <!-- ----- Voiceover: one continuous mp3 generated by edge-tts. -->
  <asset:Audio id="narration" src="./assets/narration.mp3"/>
  <pipeline:Normalize id="narration-media" source={narration}
    video="none" audio="default" span-authority="audio" clock={clock}/>

  <!-- ----- B-roll: 10 still images from MiniMax image-01 (9:16) +
       outro, each held for 12s on a 30fps clock via <pipeline:StillVideo>.
       Each image becomes a 360-frame MP4 with no audio. -->

  <asset:Image id="broll-01-cantontower" src="./assets/broll/spot-01-cantontower.jpg"/>
  <pipeline:StillVideo id="broll-01-video" duration="360f" clock={clock}>
    <pipeline:Still source={broll-01-cantontower}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-01-media" source={broll-01-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-02-baiyun" src="./assets/broll/spot-02-baiyun.jpg"/>
  <pipeline:StillVideo id="broll-02-video" duration="360f" clock={clock}>
    <pipeline:Still source={broll-02-baiyun}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-02-media" source={broll-02-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-03-shamian" src="./assets/broll/spot-03-shamian.jpg"/>
  <pipeline:StillVideo id="broll-03-video" duration="360f" clock={clock}>
    <pipeline:Still source={broll-03-shamian}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-03-media" source={broll-03-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-04-chenclan" src="./assets/broll/spot-04-chenclan.jpg"/>
  <pipeline:StillVideo id="broll-04-video" duration="360f" clock={clock}>
    <pipeline:Still source={broll-04-chenclan}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-04-media" source={broll-04-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-05-yuexiu" src="./assets/broll/spot-05-yuexiu.jpg"/>
  <pipeline:StillVideo id="broll-05-video" duration="360f" clock={clock}>
    <pipeline:Still source={broll-05-yuexiu}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-05-media" source={broll-05-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-06-pearlriver" src="./assets/broll/spot-06-pearlriver.jpg"/>
  <pipeline:StillVideo id="broll-06-video" duration="360f" clock={clock}>
    <pipeline:Still source={broll-06-pearlriver}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-06-media" source={broll-06-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-07-beijingroad" src="./assets/broll/spot-07-beijingroad.jpg"/>
  <pipeline:StillVideo id="broll-07-video" duration="360f" clock={clock}>
    <pipeline:Still source={broll-07-beijingroad}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-07-media" source={broll-07-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-08-shenzhou" src="./assets/broll/spot-08-shenzhou.jpg"/>
  <pipeline:StillVideo id="broll-08-video" duration="360f" clock={clock}>
    <pipeline:Still source={broll-08-shenzhou}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-08-media" source={broll-08-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-09-nanshatianhou" src="./assets/broll/spot-09-nanshatianhou.jpg"/>
  <pipeline:StillVideo id="broll-09-video" duration="360f" clock={clock}>
    <pipeline:Still source={broll-09-nanshatianhou}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-09-media" source={broll-09-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-10-lingnan" src="./assets/broll/spot-10-lingnan.jpg"/>
  <pipeline:StillVideo id="broll-10-video" duration="360f" clock={clock}>
    <pipeline:Still source={broll-10-lingnan}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-10-media" source={broll-10-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-outro" src="./assets/broll/spot-outro-city.jpg"/>
  <pipeline:StillVideo id="broll-outro-video" duration="360f" clock={clock}>
    <pipeline:Still source={broll-outro}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-outro-media" source={broll-outro-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>
  <!-- ----- Timeline: 11 fixed-length windows in performance order.
       迁移自旧的 <script>/<whisperx:SemanticTake>/<time:Take> 三段式
       （205bfeb9 删除了 SemanticTake 与 time:Take）。旧架构下每个空
       Segment 的 Take 时长来自它自己的 media（即每张静帧的 12s），
       所以这里用 Window 链 + {…media.extent} 保持同样的节奏。 ----- -->
  <time:Timeline id="speech" clock={clock} end="broll-outro.end">
    <time:Window id="broll-01" from="start" for={broll-01-media.extent}/>
    <time:Window id="broll-02" from="broll-01.end" for={broll-02-media.extent}/>
    <time:Window id="broll-03" from="broll-02.end" for={broll-03-media.extent}/>
    <time:Window id="broll-04" from="broll-03.end" for={broll-04-media.extent}/>
    <time:Window id="broll-05" from="broll-04.end" for={broll-05-media.extent}/>
    <time:Window id="broll-06" from="broll-05.end" for={broll-06-media.extent}/>
    <time:Window id="broll-07" from="broll-06.end" for={broll-07-media.extent}/>
    <time:Window id="broll-08" from="broll-07.end" for={broll-08-media.extent}/>
    <time:Window id="broll-09" from="broll-08.end" for={broll-09-media.extent}/>
    <time:Window id="broll-10" from="broll-09.end" for={broll-10-media.extent}/>
    <time:Window id="broll-outro" from="broll-10.end" for={broll-outro-media.extent}/>
  </time:Timeline>

  <!-- ----- Canvas: 720x1280 portrait. -->
  <space:Canvas id="vertical" width="720" height="1280"/>

  <!-- ----- Full-bleed frame. -->
  <space:Frame id="full-frame" within={vertical.bounds} left="0px" top="0px" right="720px" bottom="1280px"/>

  <!-- ----- Image track: each still placed full-bleed across its
       Segment's window. Picture switches at Take boundaries. -->
  <media-track:Track id="broll" timeline={speech.timeline}>
    <media-track:Clip id="broll-01-item" media={broll-01-media.media}
      during={speech.broll-01} frame={full-frame} z="10" fit="cover"/>
    <media-track:Clip id="broll-02-item" media={broll-02-media.media}
      during={speech.broll-02} frame={full-frame} z="10" fit="cover"/>
    <media-track:Clip id="broll-03-item" media={broll-03-media.media}
      during={speech.broll-03} frame={full-frame} z="10" fit="cover"/>
    <media-track:Clip id="broll-04-item" media={broll-04-media.media}
      during={speech.broll-04} frame={full-frame} z="10" fit="cover"/>
    <media-track:Clip id="broll-05-item" media={broll-05-media.media}
      during={speech.broll-05} frame={full-frame} z="10" fit="cover"/>
    <media-track:Clip id="broll-06-item" media={broll-06-media.media}
      during={speech.broll-06} frame={full-frame} z="10" fit="cover"/>
    <media-track:Clip id="broll-07-item" media={broll-07-media.media}
      during={speech.broll-07} frame={full-frame} z="10" fit="cover"/>
    <media-track:Clip id="broll-08-item" media={broll-08-media.media}
      during={speech.broll-08} frame={full-frame} z="10" fit="cover"/>
    <media-track:Clip id="broll-09-item" media={broll-09-media.media}
      during={speech.broll-09} frame={full-frame} z="10" fit="cover"/>
    <media-track:Clip id="broll-10-item" media={broll-10-media.media}
      during={speech.broll-10} frame={full-frame} z="10" fit="cover"/>
    <media-track:Clip id="outro-item" media={broll-outro-media.media}
      during={speech.broll-outro} frame={full-frame} z="10" fit="cover"/>
  </media-track:Track>

  <!-- ----- Audio track: continuous narration, plays across the
       whole timeline (it is slightly longer than the video). -->
  <audio-track:Track id="voice" timeline={speech.timeline}>
    <audio-track:Clip id="voice-item" source={narration-media.media}
      during={speech.window} gain="1" fade-in="200ms" fade-out="500ms"/>
  </audio-track:Track>

  <!-- ----- Final film composition. -->
  <film:Film id="main" appearance={recipes.film.vertical}
    canvas={vertical.canvas} timeline={speech.timeline}>
    <film:Track source={broll.visual}/>
    <film:Track source={voice.audio}/>
  </film:Film>

  <html:Video id="guangzhou-final" composition={main.composition}
    timeline={speech.timeline}/>
</svml>