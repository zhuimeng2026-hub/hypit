<?svml using="@hypit/markup@1"?>

<svml>
  <import from="@hypit/script@1"/>
  <import as="sound" from="@hypit/sound@1"/>
  <import as="text" from="@hypit/text@1"/>
  <import as="asset" from="@hypit/media@1"/>
  <import as="pipeline" from="@hypit/media-pipeline@1"/>
  <import as="whisperx" from="@hypit/whisperx@1"/>
  <import as="time" from="@hypit/timeline-author@1"/>
  <import as="program" from="@hypit/program-space@1"/>
  <import as="media-track" from="@hypit/media-track@1"/>
  <import as="audio-track" from="@hypit/audio-track@1"/>
  <import as="caption" from="@hypit/caption@1"/>
  <import as="caption-fine" from="@hypit/caption-fine@1"/>
  <import as="fonts" from="@hypit/fonts-open@1"/>
  <import as="space" from="@hypit/spatial@1"/>
  <import as="film" from="@hypit/film@1"/>
  <import as="render" from="@hypit/render-hyperframes@1"/>
  <import as="recipes" source="./guangzhou.svs"/>

  <!-- ============================================================
       10 Hidden Gems in Guangzhou — English-language portrait clone.

       Reuses the Guizhou-clone structure (location header + bottom
       subtitle + B-roll per spot + ambient narration) but replaces
       the source content: B-roll is generated by MiniMax text-to-image
       (no .mp4 in repo), and the narration mp3 is generated by
       edge-tts. Each spot is a truly empty <script> Segment — the
       empty-segment boundary path maps the StillVideo duration to
       the Segment, so no speech evidence audio is required.
       ============================================================ -->

  <program:Clock id="clock" frame-rate="30"/>

  <!-- ----- Voiceover: one continuous mp3 generated by edge-tts. -->
  <asset:Audio id="narration" src="./assets/narration.mp3"/>
  <pipeline:Normalize id="narration-media" source={narration}
    video="none" audio="default" span-authority="audio" clock={clock}/>

  <!-- ----- B-roll: 10 still images from MiniMax image-01 (9:16) +
       outro, each held for 12s on a 30fps clock via <pipeline:StillVideo>.
       Each image becomes a 360-frame MP4 with no audio. -->

  <asset:Image id="broll-01-cantontower" src="./assets/broll/spot-01-cantontower.jpg"/>
  <pipeline:StillVideo id="broll-01-video" duration="12" clock={clock}>
    <pipeline:Still source={broll-01-cantontower}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-01-media" source={broll-01-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-02-baiyun" src="./assets/broll/spot-02-baiyun.jpg"/>
  <pipeline:StillVideo id="broll-02-video" duration="12" clock={clock}>
    <pipeline:Still source={broll-02-baiyun}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-02-media" source={broll-02-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-03-shamian" src="./assets/broll/spot-03-shamian.jpg"/>
  <pipeline:StillVideo id="broll-03-video" duration="12" clock={clock}>
    <pipeline:Still source={broll-03-shamian}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-03-media" source={broll-03-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-04-chenclan" src="./assets/broll/spot-04-chenclan.jpg"/>
  <pipeline:StillVideo id="broll-04-video" duration="12" clock={clock}>
    <pipeline:Still source={broll-04-chenclan}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-04-media" source={broll-04-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-05-yuexiu" src="./assets/broll/spot-05-yuexiu.jpg"/>
  <pipeline:StillVideo id="broll-05-video" duration="12" clock={clock}>
    <pipeline:Still source={broll-05-yuexiu}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-05-media" source={broll-05-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-06-pearlriver" src="./assets/broll/spot-06-pearlriver.jpg"/>
  <pipeline:StillVideo id="broll-06-video" duration="12" clock={clock}>
    <pipeline:Still source={broll-06-pearlriver}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-06-media" source={broll-06-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-07-beijingroad" src="./assets/broll/spot-07-beijingroad.jpg"/>
  <pipeline:StillVideo id="broll-07-video" duration="12" clock={clock}>
    <pipeline:Still source={broll-07-beijingroad}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-07-media" source={broll-07-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-08-shenzhou" src="./assets/broll/spot-08-shenzhou.jpg"/>
  <pipeline:StillVideo id="broll-08-video" duration="12" clock={clock}>
    <pipeline:Still source={broll-08-shenzhou}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-08-media" source={broll-08-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-09-nanshatianhou" src="./assets/broll/spot-09-nanshatianhou.jpg"/>
  <pipeline:StillVideo id="broll-09-video" duration="12" clock={clock}>
    <pipeline:Still source={broll-09-nanshatianhou}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-09-media" source={broll-09-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-10-lingnan" src="./assets/broll/spot-10-lingnan.jpg"/>
  <pipeline:StillVideo id="broll-10-video" duration="12" clock={clock}>
    <pipeline:Still source={broll-10-lingnan}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-10-media" source={broll-10-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <asset:Image id="broll-outro" src="./assets/broll/spot-outro-city.jpg"/>
  <pipeline:StillVideo id="broll-outro-video" duration="12" clock={clock}>
    <pipeline:Still source={broll-outro}/>
  </pipeline:StillVideo>
  <pipeline:Normalize id="broll-outro-media" source={broll-outro-video.video}
    video="primary-moving" audio="none" span-authority="video" clock={clock}/>

  <!-- ----- Script: 11 truly empty Segments. Boundary fragment is
       selected automatically because tokenStart == tokenEndExclusive;
       no language attribute is allowed on the SemanticTake. -->
  <script id="story">
    <spot-01-cantontower/>
    <spot-02-baiyun/>
    <spot-03-shamian/>
    <spot-04-chenclan/>
    <spot-05-yuexiu/>
    <spot-06-pearlriver/>
    <spot-07-beijingroad/>
    <spot-08-shenzhou/>
    <spot-09-nanshatianhou/>
    <spot-10-lingnan/>
    <outro-city/>
  </script>

  <!-- ----- Empty-segment SemanticTakes (boundary fragment, no
       speech evidence audio needed). Each Take maps its Segment to
       the StillVideo's own boundaries. -->
  <whisperx:SemanticTake id="broll-01-take" narrative={story}
    segment={story.segment.spot-01-cantontower} media={broll-01-media.media}/>
  <whisperx:SemanticTake id="broll-02-take" narrative={story}
    segment={story.segment.spot-02-baiyun} media={broll-02-media.media}/>
  <whisperx:SemanticTake id="broll-03-take" narrative={story}
    segment={story.segment.spot-03-shamian} media={broll-03-media.media}/>
  <whisperx:SemanticTake id="broll-04-take" narrative={story}
    segment={story.segment.spot-04-chenclan} media={broll-04-media.media}/>
  <whisperx:SemanticTake id="broll-05-take" narrative={story}
    segment={story.segment.spot-05-yuexiu} media={broll-05-media.media}/>
  <whisperx:SemanticTake id="broll-06-take" narrative={story}
    segment={story.segment.spot-06-pearlriver} media={broll-06-media.media}/>
  <whisperx:SemanticTake id="broll-07-take" narrative={story}
    segment={story.segment.spot-07-beijingroad} media={broll-07-media.media}/>
  <whisperx:SemanticTake id="broll-08-take" narrative={story}
    segment={story.segment.spot-08-shenzhou} media={broll-08-media.media}/>
  <whisperx:SemanticTake id="broll-09-take" narrative={story}
    segment={story.segment.spot-09-nanshatianhou} media={broll-09-media.media}/>
  <whisperx:SemanticTake id="broll-10-take" narrative={story}
    segment={story.segment.spot-10-lingnan} media={broll-10-media.media}/>
  <whisperx:SemanticTake id="broll-outro-take" narrative={story}
    segment={story.segment.outro-city} media={broll-outro-media.media}/>

  <!-- ----- Timeline: 11 Takes in performance order. -->
  <time:Timeline id="speech" clock={clock}>
    <time:Take source={broll-01-take.take}/>
    <time:Take source={broll-02-take.take}/>
    <time:Take source={broll-03-take.take}/>
    <time:Take source={broll-04-take.take}/>
    <time:Take source={broll-05-take.take}/>
    <time:Take source={broll-06-take.take}/>
    <time:Take source={broll-07-take.take}/>
    <time:Take source={broll-08-take.take}/>
    <time:Take source={broll-09-take.take}/>
    <time:Take source={broll-10-take.take}/>
    <time:Take source={broll-outro-take.take}/>
  </time:Timeline>

  <!-- ----- Canvas: 720x1280 portrait. -->
  <space:Canvas id="vertical" width="720" height="1280"/>

  <!-- ----- Full-bleed frame. -->
  <space:Frame id="full-frame" within={vertical} left="0px" top="0px" right="720px" bottom="1280px"/>

  <!-- ----- Image track: each still placed full-bleed across its
       Segment's window. Picture switches at Take boundaries. -->
  <media-track:Track id="broll" canvas={vertical} timeline={speech.timeline}>
    <media-track:Item id="broll-01-item" media={broll-01-media.media}
      during={story.segment.spot-01-cantontower} frame={full-frame}
      appearance={recipes.media.cover}/>
    <media-track:Item id="broll-02-item" media={broll-02-media.media}
      during={story.segment.spot-02-baiyun} frame={full-frame}
      appearance={recipes.media.cover}/>
    <media-track:Item id="broll-03-item" media={broll-03-media.media}
      during={story.segment.spot-03-shamian} frame={full-frame}
      appearance={recipes.media.cover}/>
    <media-track:Item id="broll-04-item" media={broll-04-media.media}
      during={story.segment.spot-04-chenclan} frame={full-frame}
      appearance={recipes.media.cover}/>
    <media-track:Item id="broll-05-item" media={broll-05-media.media}
      during={story.segment.spot-05-yuexiu} frame={full-frame}
      appearance={recipes.media.cover}/>
    <media-track:Item id="broll-06-item" media={broll-06-media.media}
      during={story.segment.spot-06-pearlriver} frame={full-frame}
      appearance={recipes.media.cover}/>
    <media-track:Item id="broll-07-item" media={broll-07-media.media}
      during={story.segment.spot-07-beijingroad} frame={full-frame}
      appearance={recipes.media.cover}/>
    <media-track:Item id="broll-08-item" media={broll-08-media.media}
      during={story.segment.spot-08-shenzhou} frame={full-frame}
      appearance={recipes.media.cover}/>
    <media-track:Item id="broll-09-item" media={broll-09-media.media}
      during={story.segment.spot-09-nanshatianhou} frame={full-frame}
      appearance={recipes.media.cover}/>
    <media-track:Item id="broll-10-item" media={broll-10-media.media}
      during={story.segment.spot-10-lingnan} frame={full-frame}
      appearance={recipes.media.cover}/>
    <media-track:Item id="outro-item" media={broll-outro-media.media}
      during={story.segment.outro-city} frame={full-frame}
      appearance={recipes.media.cover}/>
  </media-track:Track>

  <!-- ----- Audio track: continuous narration, plays across the
       whole timeline (it is slightly longer than the video). -->
  <audio-track:Track id="voice" timeline={speech.timeline}>
    <audio-track:Item id="voice-item" source={narration-media.media}
      during="program" playback="once-start" gain="1" fade-in="200ms" fade-out="500ms"/>
  </audio-track:Track>

  <!-- ----- Final film composition. -->
  <film:Film id="main" appearance={recipes.film.vertical}
    canvas={vertical} timeline={speech.timeline}>
    <film:Track source={broll.visual}/>
    <film:Track source={voice.audio}/>
  </film:Film>

  <render:Video id="guangzhou-final" composition={main.composition}
    timeline={speech.timeline}/>
</svml>