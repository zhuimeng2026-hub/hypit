# Server-side defaults — copy to .env and edit for this LAN.
# All values here are read by docker-compose.yml; do not commit a populated .env.

# Host LAN IP that Win10 / macOS / Linux clients will reach the mirrors on.
# Keep it in sync with the box that runs `docker compose up`.
HYPIT_LAN_HOST=192.168.20.173

# Published ports (change only if you collide with another service on the host).
HYPIT_NPM_PORT=4873
HYPIT_PYPI_PORT=4874
HYPIT_CHROME_PORT=8088
HYPIT_FFMPEG_PORT=8089
# Proxy port for the existing local hypit-whisperx (binds 0.0.0.0:18765 -> 127.0.0.1:8765).
HYPIT_WHISPERX_LAN_PORT=18765
# Smart-HTTP port for the read-only git mirror of github.com/hypit-ai/hypit.
# Clients `git clone http://<HYPIT_LAN_HOST>:HYPIT_GIT_PORT/hypit.git`.
HYPIT_GIT_PORT=3030

# Where the host-side data volumes live. Override only if /opt is read-only.
HYPIT_DATA_ROOT=/opt/hypit/.internal-mirrors

# Image tags. Bump deliberately; the bootstrap scripts pin to exact upstream versions.
HYPIT_VERDACCIO_TAG=6
HYPIT_NGINX_TAG=1.27-alpine
HYPIT_SOCAT_TAG=1.8.0.0
# Tag for the local hypit/git-mirror image we build from utils/git-mirror/Dockerfile.
HYPIT_GIT_MIRROR_TAG=1

# Chrome-for-testing version pinned for the Provider. Keep in sync with
# packages/provider-hyperframes-local default browserVersion (or override it in
# hypit.runtime.json). Pick a version that actually exists on
# https://googlechromelabs.github.io/chrome-for-testing/known-good-versions-with-downloads.json
HYPIT_CHROME_VERSION=156.0.8073.0

# Upstream URLs the mirrors proxy / bootstrap from. Override to point at an even-more-internal
# source if your network policy forbids the public defaults. The PyPI upstream is baked into
# nginx/conf.d/pypi-mirror.conf — change there if you need to redirect to a Chinese mirror.
HYPIT_NPM_UPSTREAM=https://registry.npmjs.org/
HYPIT_CHROME_UPSTREAM=https://storage.googleapis.com/chrome-for-testing-public/
# Upstream of the git mirror. Override if you maintain a more-internal mirror of github.
HYPIT_GIT_UPSTREAM=https://github.com/hypit-ai/hypit.git
# How often the git-mirror background loop re-fetches upstream refs. Default 1h.
HYPIT_GIT_REFRESH_SECONDS=3600