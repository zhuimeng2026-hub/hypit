node_modules/
dist/
coverage/
# Local architecture notes and repository-specific working instructions.
/design/
/.agents/development/
/AGENTS.md
.nyc_output/
.DS_Store
*.log
*.tmp
*.temp
*.lock.editing
*.bak
_tmp-*
*._tmp-*

# Ignore local editor state while distributing repository skill-discovery links.
# The skill itself is a repository source at skills/hypit; what lives here is only the
# per-agent link that points at it.
.claude/*
!.claude/skills
.codex/*
!.codex/skills
.idea/
.vscode/

# Runtime credentials belong to the selected credential store, never Git.
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*credentials*.json
*service-account*.json

# Per-machine runtime profile: selected Endpoints, credential-store refs,
# worker counts, etc. Each developer's /opt/hypit gets its own configuration;
# the example projects ship their own tracked hypit.runtime.json instead.
/hypit.runtime.json

# Local databases and test-run reports are deployment state.
*.db
*.db-*
*.sqlite
*.sqlite-*
playwright-report/
test-results/
docs/.vitepress/cache/
docs/.vitepress/dist/
*.tsbuildinfo
.svml-cache/
.hypit/
examples/**/reused/*.mp4
examples/**/build/
examples/**/output/
examples/**/.svml/
examples/**/evidence/generated/

# Note: seed assets under examples/**/assets/ ARE intentionally tracked
# (audio, image seed files, etc.). New scratch media belong in
# .hypit/, build/, output/, or evidence/generated/ — not directly under
# assets/. The exception below un-ignores the ranking-football zero-cost
# recipe's pre-generated PNGs so other environments can run the SVML out
# of the box.
!examples/**/assets/pregen/
!examples/**/assets/pregen/**

# Session-built outputs: render frames, scratch image dumps, and the final MP4s.
# These are regenerable from the matching .svml/.svrun sources and would
# otherwise bloat the repo on every local Build.
examples/**/out.mp4
examples/**/videos/
examples/**/frames-opening.jpg
examples/**/frames-overview.jpg
examples/**/frames-overview.jpg/**

# Local authoring scratch (Python helper scripts, one-off generators, etc.).
# Frequently hardcode API tokens or environment-specific paths, so never tracked.
examples/**/scripts/
services/whisperx/.venv/
services/whisperx/build/
**/__pycache__/
*.py[cod]
services/whisperx/src/*.egg-info/
services/image-opencv/.venv/
services/image-opencv/**/__pycache__/
services/media-lambda/build/

# Local one-off preview documents are not repository sources.
/launch-video-script-*.html

# macOS Finder metadata
.DS_Store
examples/**/.svml/

# Reverse-engineering scratch projects: real output, but not the repository
/examples/*-reverse/
/examples/reference-reconstruction/

# Reverse-engineering scratch projects live outside the repository too
/projects/*
.gstack/

# Hypit project outputs (rebuilt by build-cpu.sh or by `hypit build`)
examples/guizou-clone/output-cpu.mp4
examples/guizou-clone/output-short.mp4
examples/guizou-clone/.tmp-cpu/

# Local dub-server working/scratch files
tools/dub-server/_smoke/
tools/dub-server/jobs

# Machine-specific agent notes (LAN ports, absolute paths, credential locations)
/CLAUDE.local.md

# Debug outputs from dub-server smoke tests and short-form dub runs
examples/**/out-zh*.mp4
examples/**/out-*-wav2vec2*.mp4
examples/**/out-*-chear.mp4
examples/**/out-*-ML.mp4
examples/**/out-*-htdemucs_ft.mp4
examples/**/gen-*.sh
examples/**/gen-*.py

# Per-developer workspace of source videos (used by dub experiments)
/source_video/

# Additional debug-output patterns for this session
examples/**/output-short-fresh.mp4
services/whisperx/**/.tmp-*.wav

# project.pdf 的图片资源：由 scripts/build-project-pdf.mjs 内联进 PDF，
# 二进制合计 ~2MB，不入库。重新生成的步骤见 project-images.md。
/.pdfimg/

# tools/md-to-pdf 的依赖（独立小包，自带 package.json，不进 workspace）
/tools/md-to-pdf/node_modules/

# 并行会话的临时工作区：164MB 的 chromium profile 与扩展缓存，不是交付物
/docs/docs/

# 本文档的成品产物：由 node scripts/build-project-pdf.mjs 生成，不入库
/project.pdf
/project.zip

# 参考用第三方文档：佛山华远筑业《混凝土屋面漏水修缮方案》，非本项目资产
/混凝土屋面漏水修缮方案.pdf
